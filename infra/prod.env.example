# Copy to .env.prod (never commit it) and fill in. Used with
#   docker compose -f infra/docker-compose.prod.yml --env-file .env.prod ...

# Public host name; Caddy gets a Let's Encrypt certificate for it.
BRAXY_DOMAIN=chat.example.com
ACME_EMAIL=ops@example.com

# `saci secret` (or: openssl rand -hex 64). Rotating it logs everyone out.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Object storage for uploads (AWS S3 or any S3-compatible service).
# Leave S3_ENDPOINT empty for AWS.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Password reset mails. MAIL_DELIVERY: smtp (SMTP_*), sendgrid, mailgun or
# postmark (their *_API_KEY). Links point to APP_URL (default: the domain).
MAIL_DELIVERY=smtp
MAIL_FROM="Braxy <no-reply@chat.example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# POSTMARK_API_KEY=

# Web push with Braxy closed (README: generating the VAPID keys). Empty:
# the option is hidden. The private key is a PEM; "\n" escapes work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Capacity: processes x DB_POOL should stay near the core count.
WEB_CONCURRENCY=4
DB_POOL=8
# Per-process heap budget for the GC tuner, e.g. 380M.
SACI_MEMORY_LIMIT=

# Observability: LOG_LEVEL=info logs every request (JSON); METRICS_TOKEN
# enables GET http://backend:3000/metrics for a scraper on the same network.
LOG_LEVEL=warn
METRICS_TOKEN=

# Backups (UTC).
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14

# Image tags (prebuilt in a registry) and the Saci build context.
# BRAXY_IMAGE=registry.example.com/braxy:2026-11-07
# BRAXY_WEB_IMAGE=registry.example.com/braxy-web:2026-11-07
# SACI_CONTEXT=https://github.com/pedrohvsouza/saci.git#<commit>
